#!/bin/sh
# 本地 CI 兜底：push 前跑全部单元测试（不打网络、不装 KiroCrew、不调模型）。
# CI 在 push 后也会跑，这里只是让红的那次别先烧一轮 CI。
# 启用：git config core.hooksPath .githooks
set -e
cd "$(git rev-parse --show-toplevel)"
if [ -x .venv/bin/python ]; then
    PY=.venv/bin/python
else
    PY=python3
fi
echo "[pre-push] 运行单元测试…"
"$PY" -m unittest discover -s tests
